 "font_size": 14,
 "html": "<center><img src=\"data:image/jpeg;base64,\" height=\"70px\" width=\"150px\"></center>\n<br>\n<div class=\"head\">\n<h1>KONGU ENGINEERING COLLEGE</h1>\n<h3>STUDENT FEES DETAILS</h3>\n</div>\n\n<h3>STUDENT DETAILS</h3>\n<div class=table>\n    <table>\n        <tr>\n            <td><b>Name</b</td>\n            <td>{{ doc.student_name.upper() }}</td>\n        </tr>\n        <tr>\n            <td><b>Roll Number</b></td>\n            <td>{{ doc.roll_number }}</td>\n        </tr>\n        <tr>\n            <td><b>Gender</b></td>\n            <td>{{ doc.gender }}</td>\n        </tr>\n        <tr>\n            <td><b>Year Of Study</b></td>\n            <td>{{ doc.year_of_study }}</td>\n        </tr>\n        <tr>\n            <td><b>Department</b></td>\n            <td>{{ doc.department }}</td>\n        </tr>\n        <tr>\n            <td><b>Mobile Number</b></td>\n            <td>{{ doc.mobile_number }}</td>\n        </tr>\n    </table>\n</div>\n\n<h3>FEES DETAILS</h3>\n\n<div class=\"feestable\">\n    <table>\n        <tr>\n            <td><b>Academic Fee</b</td>\n            <td>{{ doc.academic_fee }}</td>\n        </tr>\n        <tr>\n            <td><b>Status</b</td>\n            <td>\n                {% if doc.status==\"Paid\" %}\n                <span class=\"paid\">{{ doc.status }}</span>\n                {% else %}\n                <span class=\"notpaid\">{{ doc.status }}</span>\n                {% endif %}\n            </td>\n        </tr>\n    </table>\n</div>",
